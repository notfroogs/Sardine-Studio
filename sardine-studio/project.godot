; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sardine Studio"
run/main_scene="res://title/title.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://rhythm/icon.svg"

[autoload]

NavigationManager="*res://globals/navigation_manager.gd"
PauseScreenTest="*res://globals/pause_screen_test.tscn"
Gamemanager="*res://globals/gamemanager.gd"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"

[global_group]

note=""

[gui]

theme/custom_font="res://assets/fonts/KHMenu.otf"

